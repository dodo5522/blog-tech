---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>{title}</p>
    <ul class="site-footer__links">
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/sitemap-index.xml">Sitemap</a></li>
    </ul>
  </div>
</footer>
