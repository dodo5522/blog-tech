---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteSettings } from "@/lib/content/api";
const siteSettings = await getSiteSettings();
---

<BaseLayout
  siteSettings={siteSettings}
  title={`404 | ${siteSettings.siteTitle}`}
  description="ページが見つかりません。"
  canonicalPath="/404/"
>
  <section class="page-header error-page">
    <p class="eyebrow">Error / 404</p>
    <h1>ページが見つかりません</h1>
    <p>URLが変更されたか、入力したアドレスが正しくない可能性があります。</p>
    <div class="hero__actions">
      <a class="button" href="/blog/"
        >記事一覧へ <span aria-hidden="true">→</span></a
      ><a class="button button--ghost" href="/">ホームへ戻る</a>
    </div>
  </section>
</BaseLayout>
